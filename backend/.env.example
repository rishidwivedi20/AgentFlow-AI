# ---------------------------------------------------------------------------
# AgentFlow-AI backend configuration
# Copy to `.env` and fill in values. `.env` is gitignored; this file is not.
# NEVER put any of these values in the frontend - they would ship to browsers.
# ---------------------------------------------------------------------------

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins (the Vite dev server)
CORS_ORIGINS=http://localhost:5173

# ----- LLM provider (used from Phase 2 onward) -----
# Which provider the LLM service layer resolves to: "gemini" or "groq"
LLM_PROVIDER=gemini

# Google AI Studio - free tier, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq - free tier: https://console.groq.com
GROQ_API_KEY=
# Must be a model supporting strict JSON schema mode: openai/gpt-oss-20b
# or openai/gpt-oss-120b. Llama models on Groq cannot enforce a schema.
GROQ_MODEL=openai/gpt-oss-120b
# Groq counts prompt + this cap against the free tier's 8,000 tokens/minute,
# rejecting the request with a 413 if the sum is larger.
GROQ_MAX_COMPLETION_TOKENS=4096

# ----- Research provider (Phase 3) -----
# Tavily - 1,000 free credits/month, no credit card: https://app.tavily.com
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic

# ----- Retrieval (Phase 5) -----
# Embeddings always come from Gemini: Groq has no embeddings API, so retrieval
# needs GEMINI_API_KEY above even when LLM_PROVIDER=groq. Without it the
# pipeline still runs, but falls back to search snippets alone.
# The free-tier quota is on embedding REQUESTS per minute, not tokens, and is
# shared per base model - which is why chunks are embedded in batches of 100
# rather than one call each.
RETRIEVAL_ENABLED=true
EMBEDDING_MODEL=gemini-embedding-001
# Truncated from the model's native 3072. Comparable quality on a corpus this
# small, at a quarter the memory. Note these vectors are NOT unit length.
EMBEDDING_DIMENSIONS=768

# ~1200 chars is ~300 tokens per chunk; 8 chunks is ~2,400 tokens of evidence,
# which fits alongside a prompt and its output inside Groq's 8,000 tokens/min.
RETRIEVAL_CHUNK_SIZE=1200
RETRIEVAL_CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8
# Below this a chunk is treated as off-topic. Never as evidence that a claim
# is false - only that these particular sources do not discuss it.
RETRIEVAL_MIN_SIMILARITY=0.5
# Stops one long page filling the whole evidence budget. Relaxed automatically
# when honouring it would leave the budget unfilled.
RETRIEVAL_MAX_CHUNKS_PER_SOURCE=3

# Caps how much page text is embedded per run. The free tier allows 100 embedded
# passages per minute, and it counts ITEMS, not HTTP calls - every text in a
# batch is charged separately, so batching saves round trips but not quota.
# 90 leaves room for the query embedding and a second run in the same minute.
# Five uncapped pages produce 400-500 chunks and exceed the limit four times
# over. Raise this only with a paid embedding quota.
RETRIEVAL_MAX_CHUNKS_PER_RUN=90

# ----- Orchestration guardrails -----
# Hard cap on Writer <-> Editor revision cycles. Enforced in graph routing code,
# never left to the model to respect.
MAX_REVISIONS=3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ----- Cost estimates (Phase 7) -----
# USD per million tokens. Leave unset to use the built-in price table in
# app/services/pricing.py; set BOTH to override it, or to price a model the
# table does not know. Estimates only: free-tier runs are not billed.
# LLM_INPUT_PRICE_PER_MTOK=
# LLM_OUTPUT_PRICE_PER_MTOK=

# ----- Run history (Phase 7) -----
# Finished runs are kept in SQLite for the History page and /api/metrics.
RUN_STORE_ENABLED=true
# RUN_STORE_PATH=data/agentflow.db
