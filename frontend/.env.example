# ---------------------------------------------------------------------------
# Frontend configuration
#
# WARNING: every VITE_-prefixed value is compiled into the JavaScript bundle
# and is publicly readable by anyone who loads the page. Never put an API key,
# token or secret in this file - gitignoring `.env` does not make it private.
# All LLM provider calls go through the FastAPI backend for exactly this reason.
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=http://localhost:8000
